{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PyroSyncHarmonization",
  "type": "object",
  "required": ["status", "method", "version", "blendStart", "scale", "description", "validation"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["provisional", "validated"]
    },
    "method": { "type": "string" },
    "version": { "type": "string" },
    "blendStart": { "type": "string", "const": "2012-02" },
    "scale": {
      "type": "object",
      "required": ["global", "terraOnly", "bySeason"],
      "properties": {
        "global": { "type": ["number", "null"] },
        "terraOnly": { "type": ["number", "null"] },
        "bySeason": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "description": { "type": "string" },
    "validation": {
      "type": "object",
      "required": ["notes", "metrics"],
      "properties": {
        "notes": { "type": "string" },
        "metrics": { "type": "object" }
      }
    }
  }
}

