{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PyroSyncValidation",
  "type": "object",
  "required": ["tables", "figures"],
  "properties": {
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "note", "columns", "rows"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "columns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": ["string", "number", "null", "boolean"] }
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "src", "alt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "src": { "type": "string" },
          "alt": { "type": "string" }
        }
      }
    }
  }
}

