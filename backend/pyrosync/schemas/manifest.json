{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PyroSyncManifest",
  "type": "object",
  "required": [
    "version",
    "generatedAtUtc",
    "synthetic",
    "studyArea",
    "coverage",
    "modisStart",
    "viirsStart",
    "viirsFirstCompleteMonth",
    "viirsPartialMonths",
    "firstAquaMonth",
    "grid",
    "totals",
    "sources",
    "filters"
  ],
  "properties": {
    "version": { "type": "string" },
    "generatedAtUtc": { "type": "string" },
    "synthetic": { "type": "boolean" },
    "studyArea": {
      "type": "object",
      "required": ["name", "bbox"],
      "properties": {
        "name": { "type": "string" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "areaKm2": { "type": "number", "exclusiveMinimum": 0 },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "bbox"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "bbox": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "modisStart": { "type": "string" },
    "viirsStart": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "viirsFirstCompleteMonth": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "viirsPartialMonths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "firstAquaMonth": { "type": "string" },
    "grid": {
      "type": "object",
      "required": ["cellKm", "crs", "cells"],
      "properties": {
        "cellKm": { "type": "integer", "const": 10 },
        "crs": { "type": "string", "const": "EPSG:6933" },
        "cells": { "type": "integer", "minimum": 1 }
      }
    },
    "totals": {
      "type": "object",
      "required": ["modisDetections", "viirsDetections"],
      "properties": {
        "modisDetections": { "type": "integer", "minimum": 0 },
        "viirsDetections": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "filters": { "type": "string" }
  }
}

